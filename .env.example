CRON_SCHEDULE_FILE=config/schedule.yaml
CRON_POLL_INTERVAL_SECONDS=1
CRON_CONFIG_RELOAD_SECONDS=0
API_LISTEN_ADDRESS=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/shared_db

# Shared Postgres for quant_symbols/quant_daily_bars/quant_momentum/quant_indicators
QUANT_DATABASE_URL=postgresql+psycopg://quant:quant_dev_password@localhost:5432/quant

# OpenAI-compatible Ollama endpoint used by scripts/daily_ingestion_report.py
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1
OLLAMA_API_KEY=

# Discord incoming webhook the daily ingestion report is posted to
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/CHANGE_ME/CHANGE_ME
